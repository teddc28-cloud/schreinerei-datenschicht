# Postgres-Connection (Railway liefert das als DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Hero API v9
HERO_API_TOKEN=ac_...
HERO_API_URL=https://login.hero-software.de/api/external/v9/graphql

# Session-Secret fuer Login (beliebiger langer Zufallsstring)
SESSION_SECRET=change-me

PORT=3000

# false fuer lokale Entwicklung (sonst sofortiger Sync bei jedem --watch-Neustart).
# Auf Railway weglassen oder auf true setzen.
SCHEDULER_ENABLED=true

# --- Datenschicht v3 (optional, Standardwerte passen fuer Railway) ---
# Zeitzone fuer Monats-/Wochengrenzen und DB-Sitzungen. Standard Europe/Berlin (ueberschreibt TZ).
# APP_TZ=Europe/Berlin
# Sperrdauer je Bereichslauf in Sekunden (Verlaengerung nach halber Laufzeit). Standard 1800.
# SYNC_LEASE_SECONDS=1800
# Loesch-Probelauf nach vollstaendigem Bereichsabruf: on (Standard) | off. Markiert NIE etwas.
# DELETION_PROBE=on
